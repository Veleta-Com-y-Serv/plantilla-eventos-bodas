---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="contenedor py-24 text-center md:py-36">
    <div class="caja-marfil mx-auto max-w-[36rem]">
      <p class="antetitulo">Error 404</p>
      <h1 class="titulo-seccion">Esta página no existe</h1>
      <p class="ornamento" aria-hidden="true"><i></i></p>
      <p class="suave mt-5">Puede que el enlace esté mal o que la página se haya movido.</p>
      <p class="mt-9"><a class="btn" href="/">Volver al inicio</a></p>
    </div>
  </section>
</Base>
