---
// Opiniones: `testimonios: [{texto, autor, nota?}]` (parejas) centrados en un carrusel sin JavaScript:
// la lista se desplaza en horizontal con scroll-snap (solo la lista, nunca la página) y se puede mover con el
// teclado al enfocarla. Sin testimonios no se pinta (la plataforma nunca inventa opiniones).
import { seccion, cadena } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const lista = (s?.testimonios ?? []).filter((t) => cadena(t.texto));
---

{
  s && lista.length > 0 && (
    <Seccion id={Astro.props.id} class="salvia">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <ul class="carrusel" tabindex="0" aria-label={s.titulo || s.antetitulo || undefined}>
        {lista.map((t) => (
          <li>
            <figure class="opinion">
              <span class="opinion-comilla" aria-hidden="true">&ldquo;</span>
              <blockquote class="mt-4">{t.texto}</blockquote>
              <figcaption class="mt-6">
                <span class="versalitas block">{t.autor}</span>
                {cadena(t.nota) && <span class="suave mt-1 block text-sm italic">{t.nota}</span>}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </Seccion>
  )
}
