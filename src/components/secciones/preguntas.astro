---
// Preguntas frecuentes: `preguntas: [{pregunta, respuesta}]` en acordeón nativo (details/summary),
// en una columna estrecha centrada con filetes dorados. Sin preguntas no se pinta.
import { seccion, parrafos } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const lista = (s?.preguntas ?? []).filter((p) => p.pregunta);
---

{
  s && lista.length > 0 && (
    <Seccion id={Astro.props.id}>
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <div class="preguntas estrecho">
        {lista.map((p) => (
          <details>
            <summary>{p.pregunta}</summary>
            <div class="space-y-3">
              {parrafos(p.respuesta).map((t) => <p>{t}</p>)}
            </div>
          </details>
        ))}
      </div>
    </Seccion>
  )
}
