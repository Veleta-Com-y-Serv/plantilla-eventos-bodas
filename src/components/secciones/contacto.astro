---
// Contacto: titular centrado, `texto`, datos de site.yaml → contacto en una línea y formulario (mailto) con
// fecha del evento, tipo e invitados. `tipos_evento`: cadena separada por «;» con las opciones del tipo
// (vacía = Boda; Comunión; Empresa; Otro). `imagen` opcional junto al formulario. `boton`: texto del botón.
import { seccion, site, tel, whatsapp, cadena, partes } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const c = site.contacto;
const tiposPropios = partes(s?.tipos_evento);
const tipos = tiposPropios.length > 0 ? tiposPropios : ['Boda', 'Comunión', 'Empresa', 'Otro'];
const boton = cadena(s?.boton) || undefined;
---

{
  s && (
    <Seccion id={Astro.props.id}>
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <ul class="-mt-4 mb-12 flex flex-wrap justify-center gap-x-8 gap-y-3 text-center">
        {c.telefono && (
          <li><a class="inline-flex items-center gap-2 no-underline hover:underline" href={tel(c.telefono)}><Icono nombre="telefono" class="text-acento" tam={18} /><span class="sr-only">Teléfono: </span>{c.telefono}</a></li>
        )}
        {c.whatsapp && (
          <li><a class="inline-flex items-center gap-2 no-underline hover:underline" href={whatsapp(c.whatsapp)} rel="noopener" target="_blank"><Icono nombre="whatsapp" class="text-acento" tam={18} /><span class="sr-only">WhatsApp: </span>{c.whatsapp}</a></li>
        )}
        {c.email && (
          <li><a class="inline-flex items-center gap-2 break-all no-underline hover:underline" href={`mailto:${c.email}`}><Icono nombre="correo" class="shrink-0 text-acento" tam={18} /><span class="sr-only">Email: </span>{c.email}</a></li>
        )}
        {c.horario && (
          <li class="suave"><Icono nombre="reloj" class="mr-2 inline-block align-[-3px] text-acento" tam={18} /><span class="sr-only">Horario: </span>{c.horario}</li>
        )}
      </ul>
      <div class:list={['mx-auto grid items-stretch gap-8', s.imagen ? 'max-w-6xl md:grid-cols-12' : 'max-w-3xl']}>
        {s.imagen && (
          <span class="marco hidden md:col-span-5 md:block">
            <Imagen src={s.imagen} alt="" ancho={900} alto={1125} class="h-full w-full object-cover" />
          </span>
        )}
        <div class:list={['caja-form', s.imagen && 'md:col-span-7']}>
          <FormularioContacto tipos={tipos} boton={boton} />
        </div>
      </div>
    </Seccion>
  )
}
