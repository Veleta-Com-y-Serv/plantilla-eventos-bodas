---
// Apartado de texto genérico, centrado: antetítulo, título en cursiva, ornamento, imagen opcional (3:2) con marco,
// párrafos en columna estrecha, lista con iconos y botón.
// Lo usan los apartados nuevos que pide el cliente (site.yaml: `tipo: texto`).
import { seccion, parrafos } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id}>
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} />
      {s.imagen && (
        <span class="marco mx-auto mb-12 max-w-4xl">
          <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={800} class="aspect-[3/2] w-full object-cover" />
        </span>
      )}
      <div class="estrecho space-y-4 text-center text-lg">
        {parrafos(s.texto).map((p) => <p>{p}</p>)}
      </div>
      {s.items.length > 0 && (
        <ul class="estrecho mt-10 grid gap-8 text-center sm:grid-cols-2">
          {s.items.map((it) => (
            <li>
              <Icono nombre={it.icono} class="mx-auto text-acento" tam={26} />
              <p class="mt-3 font-display text-xl italic">{it.titulo}</p>
              {it.texto && <p class="suave mt-1">{it.texto}</p>}
            </li>
          ))}
        </ul>
      )}
      {s.cta?.url && <p class="mt-12 text-center"><a class="btn" href={s.cta.url}>{s.cta.texto}</a></p>}
    </Seccion>
  )
}
