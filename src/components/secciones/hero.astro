---
// Portada: foto a todo el ancho (`imagen`) y, encima, una caja marfil centrada con filete dorado:
// `antetitulo`, título en serif cursiva, ornamento, `texto`, `cta` y `cta_secundario` (opcional).
// En móvil la foto va arriba y la caja se monta encima de su borde inferior. Sin imagen, fondo salvia claro.
import { seccion, enlace } from '../../data/site';
import { altHero } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string; primera?: boolean }
const { id, primera = false } = Astro.props;
const s = seccion(id);
const cta = enlace(s?.cta);
const cta2 = enlace(s?.cta_secundario);
---

{
  s && (
    <section id={id} class:list={['relative overflow-hidden pb-14 md:grid md:min-h-[88svh] md:place-items-center md:py-24', !s.imagen && 'salvia pt-14']}>
      {s.imagen && (
        <Imagen src={s.imagen} alt={altHero()} ancho={1920} alto={1080} prioridad={primera} class="block h-[56svh] w-full object-cover md:absolute md:inset-0 md:h-full" />
      )}
      <div class:list={['contenedor relative', s.imagen && '-mt-24 md:mt-0']}>
        <div class="caja-marfil mx-auto max-w-[40rem]">
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {s.titulo && <h1 class="mt-4 text-[clamp(2.3rem,7vw,4.4rem)] leading-[1.08]">{s.titulo}</h1>}
          <p class="ornamento" aria-hidden="true"><i></i></p>
          {s.texto && <p class="suave mx-auto mt-5 max-w-[30rem] text-lg">{s.texto}</p>}
          {(cta || cta2) && (
            <div class="mt-8 flex flex-wrap justify-center gap-3">
              {cta && <a class="btn" href={cta.url}>{cta.texto}</a>}
              {cta2 && <a class="btn-sec" href={cta2.url}>{cta2.texto}</a>}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
