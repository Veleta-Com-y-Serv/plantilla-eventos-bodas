---
// Formulario sin servidor: si hay email en site.yaml abre el programa de correo (mailto) con todos los campos
// (nombre, contacto, fecha del evento, tipo, invitados y mensaje) en el cuerpo. Si no hay email, se queda como
// muestra y lo avisa. `tipos`: opciones del desplegable «Tipo de evento» (de secciones.contacto.tipos_evento).
// Para un envío real, cambia `action` por el de tu proveedor.
import { site } from '../../data/site';
interface Props { boton?: string; class?: string; asunto?: string; tipos?: string[] }
const { boton = 'Enviar', class: clase = '', asunto = `Consulta desde la web de ${site.nombre}`, tipos = [] } = Astro.props;
const email = site.contacto.email;
const accion = email ? `mailto:${email}?subject=${encodeURIComponent(asunto)}` : '';
---

<form class:list={['formulario', clase]} action={accion || undefined} method="post" enctype="text/plain">
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="campo">
      <label for="f-nombre">Nombre</label>
      <input id="f-nombre" name="nombre" type="text" autocomplete="name" required />
    </div>
    <div class="campo">
      <label for="f-contacto">Email o teléfono</label>
      <input id="f-contacto" name="contacto" type="text" autocomplete="email" required />
    </div>
    <div class="campo">
      <label for="f-fecha">Fecha del evento</label>
      <input id="f-fecha" name="fecha" type="date" />
    </div>
    <div class="campo">
      <label for="f-invitados">Invitados</label>
      <input id="f-invitados" name="invitados" type="number" min="1" max="2000" inputmode="numeric" />
    </div>
  </div>
  {
    tipos.length > 0 && (
      <div class="campo">
        <label for="f-tipo">Tipo de evento</label>
        <select id="f-tipo" name="tipo">
          {tipos.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>
    )
  }
  <div class="campo">
    <label for="f-mensaje">Mensaje</label>
    <textarea id="f-mensaje" name="mensaje" rows="4" required></textarea>
  </div>
  <label class="campo-check">
    <input type="checkbox" name="privacidad" required />
    <span>He leído el <a href="/aviso-legal">aviso legal y la política de privacidad</a>.</span>
  </label>
  <button type="submit" class="btn">{boton}</button>
  <p class="formulario-aviso">
    {
      email
        ? 'Al enviar se abre tu programa de correo con el mensaje listo.'
        : 'Formulario de muestra: todavía no envía mensajes. Usa el teléfono o el email de contacto.'
    }
  </p>
</form>
